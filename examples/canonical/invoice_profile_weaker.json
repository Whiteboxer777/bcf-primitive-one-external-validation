{
  "profile_id": "invoice_admission_v82_weaker",
  "mode": "object",
  "description": "Weaker invoice boundary",
  "analysis_domains": {
    "object.amount": {
      "kind": "bounded_int",
      "min": 0,
      "max": 12000,
      "step": 1000
    },
    "object.currency": {
      "kind": "enum",
      "values": [
        "EUR",
        "USD"
      ]
    },
    "object.vendor": {
      "kind": "enum",
      "values": [
        "ACME",
        "Globex",
        "Bad Vendor"
      ]
    }
  },
  "root": {
    "kind": "AND",
    "children": [
      {
        "kind": "IN",
        "path": "vendor",
        "value": [
          "ACME",
          "Globex",
          "Bad Vendor"
        ],
        "metadata": {
          "rule_id": "vendor_allowlist"
        }
      },
      {
        "kind": "EQ",
        "path": "currency",
        "value": "EUR",
        "metadata": {
          "rule_id": "eur_only"
        }
      },
      {
        "kind": "RANGE",
        "path": "amount",
        "low": 0,
        "high": 12000,
        "metadata": {
          "rule_id": "amount_cap"
        }
      }
    ]
  }
}